diff --git a/BountyHunters-Common/src/test/java/net/Indyuce/bountyhunters/common/gui/editable/item/builtin/NavigationPlaceholdersTest.java b/BountyHunters-Common/src/test/java/net/Indyuce/bountyhunters/common/gui/editable/item/builtin/NavigationPlaceholdersTest.java
new file mode 100644
index 0000000..7ad334e
--- /dev/null
+++ b/BountyHunters-Common/src/test/java/net/Indyuce/bountyhunters/common/gui/editable/item/builtin/NavigationPlaceholdersTest.java
@@ -0,0 +1,45 @@
+package net.Indyuce.bountyhunters.common.gui.editable.item.builtin;
+
+import java.util.stream.Stream;
+import net.Indyuce.bountyhunters.common.compat.placeholder.PlaceholderParser;
+import net.Indyuce.bountyhunters.common.gui.Navigator;
+import net.Indyuce.bountyhunters.common.gui.editable.GeneratedInventory;
+import net.Indyuce.bountyhunters.common.gui.editable.item.PhysicalItem;
+import net.Indyuce.bountyhunters.common.gui.editable.placeholder.Placeholders;
+import net.Indyuce.bountyhunters.common.util.AbstractPlugin;
+import org.bukkit.OfflinePlayer;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.MethodSource;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class NavigationPlaceholdersTest {
+    static Stream<Class<? extends PhysicalItem>> buttons() {
+        return Stream.of(NextPageItem.class, PreviousPageItem.class,
+                GoBackItem.class, CloseInventoryItem.class);
+    }
+
+    @ParameterizedTest
+    @MethodSource("buttons")
+    void usesInventoryParserAndPreservesUnknownPlaceholders(Class<? extends PhysicalItem> type) {
+        AbstractPlugin plugin = mock(AbstractPlugin.class);
+        PlaceholderParser parser = mock(PlaceholderParser.class);
+        when(plugin.getPlaceholderParser()).thenReturn(parser);
+        Navigator navigator = mock(Navigator.class);
+        when(navigator.getPlugin()).thenReturn(plugin);
+        GeneratedInventory inventory = mock(GeneratedInventory.class);
+        when(inventory.getNavigator()).thenReturn(navigator);
+        OfflinePlayer player = mock(OfflinePlayer.class);
+        when(parser.parse(player, "&aNext %player_name% {unknown}"))
+                .thenReturn("&aNext ExamplePlayer {unknown}");
+
+        // Run the actual factory without initializing unrelated Bukkit item metadata.
+        PhysicalItem item = mock(type, CALLS_REAL_METHODS);
+        Placeholders placeholders = item.getPlaceholders(inventory, 0);
+        assertNull(placeholders.parsePlaceholder("unknown"));
+        assertEquals("\u00a7aNext ExamplePlayer {unknown}",
+                placeholders.apply(player, "&aNext %player_name% {unknown}"));
+        verify(parser).parse(same(player), eq("&aNext %player_name% {unknown}"));
+    }
+}
