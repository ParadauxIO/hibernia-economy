# Flyway connection for `./gradlew :economy-flyway:flywayMigrate` (and Info,
# Validate, Repair). Gradle does not read .env files itself; load this into the
# environment first:
#   set -a; . economy-flyway/.env; set +a
#
# The first three are REQUIRED: the build refuses to run a Flyway task unless
# each is set explicitly, so a bare run can never connect as root with no
# password to whatever is on localhost. An explicit empty password is accepted.
# The same values can be passed as -PflywayUrl / -PflywayUser / -PflywayPassword.

FLYWAY_URL=jdbc:mysql://localhost:3306/economy
FLYWAY_USER=root
FLYWAY_PASSWORD=

# Schema that holds the tables and flyway_schema_history. Usually the database
# named in FLYWAY_URL.
#FLYWAY_SCHEMA=economy

# Not environment variables — pass on the command line when needed:
#   -Pbaseline=true              first run against a database that already has tables
#   -PflywayCleanEnabled=true    allow flywayClean (wipes the schema; never in production)
