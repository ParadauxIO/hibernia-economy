        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(explorer_render_seconds_bucket{tenant=~\"$tenant\", kind=~\"$kind\"}[$__rate_interval])))",
          "legendFormat": "{{route}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
