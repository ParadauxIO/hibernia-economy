# Economy Explorer environment. Copy to .env (git-ignored) for local dev.
#
# Variables left uncommented are REQUIRED. Commented ones are optional and show
# their built-in default (or an example where the default is "off").

# ── Database (MariaDB economy schema) ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=economy
DB_USERNAME=economy_explorer
DB_PASSWORD=
# Connection pool size.
#DB_POOL=100
# Per-statement timeout in seconds, so one slow aggregate can't pin a connection.
#DB_STMT_TIMEOUT_S=15

# ── Rollup worker (background aggregation inside this process) ──────────────
# Runs by default; one pod leads at a time through a Redis lease. Off under
# Vitest and the e2e server unless set to "on". Set "off" to disable it.
#ROLLUP_WORKER=on
# Statement timeout in seconds for the worker's own 2-connection pool.
#ROLLUP_DB_STMT_TIMEOUT_S=300
# How often the leader recomputes today (ms); rollups lag by at most about one tick.
#ROLLUP_TICK_MS=300000
# How long after 00:00 UTC yesterday is still recomputed every tick (ms).
#ROLLUP_YESTERDAY_WINDOW_MS=3600000
# Minimum time between wealth snapshots (ms); today's row is refreshed in place.
#ROLLUP_WEALTH_EVERY_MS=900000
# Pause between backfilled days (ms), to stay gentle on a shared database.
#ROLLUP_BACKFILL_PAUSE_MS=250

# ── Sign-in (Keycloak OIDC via NextAuth) ─────────────────────────────────────
AUTH_KEYCLOAK_ISSUER=https://auth.paradaux.io/realms/minecraft
AUTH_KEYCLOAK_ID=treasury-explorer
# Public client: no secret. NextAuth still requires the field; leave empty and
# set token_endpoint_auth_method='none' on the provider.
AUTH_KEYCLOAK_SECRET=
# Session signing key — generate with `openssl rand -base64 32`.
AUTH_SECRET=
# Externally visible base URL of this app.
AUTH_URL=http://localhost:3000
# Set when running behind a proxy or on a host NextAuth doesn't recognise.
#AUTH_TRUST_HOST=true

# ── Tenant and branding ──────────────────────────────────────────────────────
# Tenant identifier for logs, metrics and cache keys (democracycraft | statecraft).
TENANT=democracycraft
# Colour theme, which also picks the default server identity below (blue | red).
#THEME=blue
# Currency symbol shown before amounts.
#CURRENCY_SYMBOL=$
# Canonical URL for metadata, sitemap and robots. Defaults to AUTH_URL.
#SITE_URL=http://localhost:3000
# Server identity. Each defaults from THEME (blue = DemocracyCraft, red = StateCraft).
#SERVER_NAME=DemocracyCraft
#SERVER_IP=play.democracycraft.net
#SERVER_ICON=https://www.democracycraft.net/data/assets/logo_alternate/dc-emblem.png
# BlueMap base URL, and the camera distance (blocks) used for shop deep links.
#MAP_URL=https://map.democracycraft.net
#MAP_ZOOM=60
# In-game command the account page's "Copy /pay command" copies, per account
# type. Placeholders: {player} {account} {firm} {id}. Set one empty to hide it.
#PAY_COMMAND_PERSONAL=/pay {player} <amount>
#PAY_COMMAND_GOVERNMENT=/pay {account} <amount>
#PAY_COMMAND_BUSINESS=/firm account pay into {firm} {id} <amount>
# Where item icons are loaded from: <base>/<material>.png
#ITEM_ICON_BASE=https://static.minecraftitemids.com/64/
# Player head service behind the /api/avatar proxy ({uuid} and {size} are filled in).
# Fetched server-side and cached 24 h, so visitors' IPs never reach it.
#AVATAR_URL_TEMPLATE=https://mc-heads.net/avatar/{uuid}/{size}
# Server status API used for the online-players badge.
#MC_STATUS_API=https://api.mcsrvstat.us/3
# Year shown in the footer copyright. Blank when unset.
#BUILD_YEAR=2026

# ── Treasury admin API (admin actions and webhook management) ────────────────
# Without both, read-only pages work and admin actions fail with a clear error.
# Also used without credentials for public live tax rates (PAR-80 /config/tax).
# If that endpoint is absent, Taxation shows rates as unavailable.
# Base origin plus any gateway prefix; do NOT append /api/v1 (admin calls add it).
#TREASURY_API_BASE_URL=http://localhost:8080
# A SERVICE token for the REST API. Mint one with scripts/mint-service-token.mjs.
#TREASURY_ADMIN_TOKEN=

# ── Optional services (each is off when its variable is unset) ───────────────
# Shared cache. Without REDIS_HOST the app caches in-process.
#REDIS_HOST=localhost
#REDIS_PORT=6379
#REDIS_PASSWORD=
# API-key usage figures on the admin API keys page.
#PROMETHEUS_URL=http://localhost:9090
# Bearer token for the Prometheus scrape endpoint /metrics. Unset = /metrics is a 404.
#METRICS_TOKEN=
# Umami analytics: both must be set.
#UMAMI_SCRIPT_URL=
#UMAMI_WEBSITE_ID=
# Grafana Faro browser telemetry.
#FARO_COLLECTOR_URL=

# ── Never set outside tests ──────────────────────────────────────────────────
# E2E_TEST_AUTH=1 lets a cookie assume any role. `npm run test:e2e` sets it for
# the instance it starts; it must not be present in any deployed environment.

# ── Request blocking (off by default; restart after changing) ───────────────
# Comma-separated IPv4/IPv6 addresses or CIDRs. Invalid rules fail startup.
#BLOCKED_IPS=136.107.101.57
# Case-sensitive exact User-Agent values, or literal substrings (no regex).
#BLOCKED_UAS=Blockantir-BalanceCollector/1.0
#BLOCKED_UA_SUBSTRINGS=
# Required for IP rules: trust only Cilium's overwritten external-address header.
# Enable ONLY after restricting direct app ingress and verifying gateway behavior.
#BLOCK_TRUST_ENVOY=1
