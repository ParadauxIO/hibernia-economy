<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Quiet down Netty's chatter; surface our logs and any errors. -->
    <logger name="io.netty" level="WARN"/>
    <logger name="org.geysermc.mcprotocollib" level="INFO"/>
    <logger name="io.paradaux.mockclient" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
