# Treasury REST API environment. Spring does not read .env files itself; load
# this into the process environment, e.g.
#   docker run --env-file .env …          or          set -a; . ./.env; set +a
#
# Variables left uncommented are REQUIRED. Commented ones are optional and show
# their built-in default. The `uat` profile reads the database, token-signing,
# HTTP and rate-limiting variables under a UAT_ prefix (UAT_DB_URL,
# UAT_JWT_SECRET, …); the feed and webhook variables keep their plain names.

# Profile: unset for local dev (defaults in application.yaml), `prod` or `uat`
# when deployed. The Docker image sets prod.
#SPRING_PROFILES_ACTIVE=prod

# ── Database ─────────────────────────────────────────────────────────────────
# Required in prod/uat; local dev defaults to the values shown. The prod profile
# refuses to start with the password `password`.
DB_URL=jdbc:mariadb://localhost:3306/treasury
DB_USERNAME=root
DB_PASSWORD=
# Connection pool (prod/uat profiles; uat defaults are 10 and 2).
#DB_POOL_SIZE=20
#DB_POOL_MIN_IDLE=5

# ── Token signing ────────────────────────────────────────────────────────────
# Must be byte-identical to api.jwt-secret in the TreasuryAPI plugin's config.yml.
# Use random key material: base64:$(openssl rand -base64 48). The app refuses to
# start with the bundled placeholder or anything shorter than 32 characters.
JWT_SECRET=

# ── HTTP ─────────────────────────────────────────────────────────────────────
# (prod/uat profiles; local dev always listens on 8080 with actuator on the same port.)
#SERVER_PORT=8080
#MANAGEMENT_PORT=8081
#TOMCAT_MAX_THREADS=200
# Honour X-Forwarded-* from the gateway (prod only).
#SERVER_FORWARD_HEADERS_STRATEGY=framework
# Extra JVM flags for the Docker image.
#JAVA_OPTS=

# ── Rate limiting ────────────────────────────────────────────────────────────
# Without a Redis host the limiter is in-memory and per-process.
#RATE_LIMIT_REDIS_HOST=
#RATE_LIMIT_REDIS_PORT=6379
#RATE_LIMIT_REDIS_PASSWORD=

# ── Transaction feed and webhooks ────────────────────────────────────────────
# Only transactions settled at least this long ago are surfaced, so a cursor
# never skips a row that committed out of order.
#FEED_SETTLEMENT_LAG_SECONDS=3
# The dispatcher is single-holder through the rate-limit Redis; with no Redis it
# runs in single-process mode.
#WEBHOOK_ENABLED=true
#WEBHOOK_POLL_MS=2000
#WEBHOOK_SETTLEMENT_LAG_SECONDS=3
#WEBHOOK_INGEST_BATCH=500
#WEBHOOK_DELIVERY_BATCH=100
# Deliveries sent in parallel within a batch.
#WEBHOOK_DELIVERY_CONCURRENCY=8
#WEBHOOK_CONNECT_TIMEOUT_MS=5000
#WEBHOOK_HTTP_TIMEOUT_MS=10000
# Retries back off from the base up to the cap; a delivery is dropped after
# max-attempts, and a subscription is disabled after failure-threshold failures.
#WEBHOOK_MAX_ATTEMPTS=5
#WEBHOOK_RETRY_BASE_SECONDS=30
#WEBHOOK_RETRY_MAX_SECONDS=3600
#WEBHOOK_FAILURE_THRESHOLD=15
# Subscriptions allowed per API key.
#WEBHOOK_MAX_PER_KEY=20
# How long the dispatcher lease is held before another instance may take over.
#WEBHOOK_LOCK_TTL_MS=15000
