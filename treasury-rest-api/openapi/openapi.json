  "info" : {
    "contact" : {
      "name" : "DemocracyCraft",
      "url" : "https://democracycraft.net"
    },
    "description" : "HTTP surface for the DemocracyCraft Treasury economy. Players issue an API key in-game with `/treasuryapi`, then use the token to authenticate every call here.\n\n**Two token scopes:**\n- **PERSONAL** — JWT carries an `acc` claim. Source of every transfer is   the player's PERSONAL account.\n- **BUSINESS** — JWT carries a `firm` claim. The caller picks one of the   firm's accounts to debit via the `fromAccountId` body field; the firm   ownership check happens server-side.\n\n**Money is always a decimal string.** Never JSON `number` — IEEE 754 rounding will silently corrupt amounts at scale.\n\n**Errors share a flat envelope** `{ \"error\": \"SNAKE_CASE_CODE\", \"message\": \"...\" }`. The `error` code is stable across versions; the message is informational.\n",
    "license" : {
      "name" : "Proprietary"
    },
    "title" : "Treasury REST API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/accounts/by-player" : {
      "get" : {
        "description" : "**Rate limits:** 60 requests/minute for PERSONAL keys, 300 requests/minute for BUSINESS keys. Exceeding the limit returns HTTP 429 with a `Retry-After` header (in seconds). The response also includes `X-RateLimit-Limit` and `X-RateLimit-Remaining` headers on every successful call.",
        "operationId" : "getAccountByPlayer",
        "parameters" : [ {
          "in" : "query",
          "name" : "uuid",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "name",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AccountByPlayerResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "account-controller" ]
      }
    },
    "/api/v1/accounts/{accountId}/balance" : {
      "get" : {
        "description" : "**Rate limits:** 120 requests/minute for PERSONAL keys, 600 requests/minute for BUSINESS keys. Exceeding the limit returns HTTP 429 with a `Retry-After` header (in seconds). The response also includes `X-RateLimit-Limit` and `X-RateLimit-Remaining` headers on every successful call.",
        "operationId" : "getBalance",
        "parameters" : [ {
          "in" : "path",
          "name" : "accountId",
          "required" : true,
          "schema" : {
            "format" : "int64",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AccountBalanceResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "account-controller" ]
      }
    },
    "/api/v1/accounts/{accountId}/transactions" : {
      "get" : {
        "description" : "**Rate limits:** 60 requests/minute for PERSONAL keys, 300 requests/minute for BUSINESS keys. Exceeding the limit returns HTTP 429 with a `Retry-After` header (in seconds). The response also includes `X-RateLimit-Limit` and `X-RateLimit-Remaining` headers on every successful call.",
        "operationId" : "getTransactions",
        "parameters" : [ {
          "in" : "path",
          "name" : "accountId",
          "required" : true,
          "schema" : {
            "format" : "int64",
            "type" : "integer"
          }
        }, {
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "default" : 1,
            "format" : "int32",
            "type" : "integer"
          }
