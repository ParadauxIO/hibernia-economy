# Repo-wide Lombok settings (applies to every module below this directory).
config.stopBubbling = true

# Mark Lombok-generated getters/setters/equals/hashCode/toString/builders with
# @lombok.Generated (CLASS retention). JaCoCo and PIT both skip @Generated code,
# so coverage and mutation scores measure hand-written logic only — nobody has to
# write getter round-trip tests to keep a line-coverage gate green.
lombok.addLombokGeneratedAnnotation = true
